# Copy to .env; fill the key locally. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.2
# Code generation can take longer; 300 seconds is a starting point.
DEEPSEEK_TIMEOUT=300
DEEPSEEK_MAX_RETRIES=2
# disabled reduces reasoning latency; enabled prioritizes deeper analysis.
DEEPSEEK_THINKING=disabled
